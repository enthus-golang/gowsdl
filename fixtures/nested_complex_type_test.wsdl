<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://example.com/nested"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             targetNamespace="http://example.com/nested"
             name="NestedComplexTypes">
    <types>
        <xsd:schema targetNamespace="http://example.com/nested">
            <!-- A complex type with deeply nested complex types -->
            <xsd:complexType name="Company">
                <xsd:sequence>
                    <xsd:element name="Name" type="xsd:string"/>
                    <xsd:element name="Department">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="DeptName" type="xsd:string"/>
                                <xsd:element name="Manager">
                                    <!-- This is a nested complex type within a nested complex type -->
                                    <xsd:complexType>
                                        <xsd:sequence>
                                            <xsd:element name="FirstName" type="xsd:string"/>
                                            <xsd:element name="LastName" type="xsd:string"/>
                                            <xsd:element name="Email" type="xsd:string"/>
                                        </xsd:sequence>
                                    </xsd:complexType>
                                </xsd:element>
                                <xsd:element name="Employees" maxOccurs="unbounded">
                                    <!-- Another nested complex type in an unbounded element -->
                                    <xsd:complexType>
                                        <xsd:sequence>
                                            <xsd:element name="EmployeeId" type="xsd:int"/>
                                            <xsd:element name="Name" type="xsd:string"/>
                                            <xsd:element name="Role" type="xsd:string"/>
                                        </xsd:sequence>
                                    </xsd:complexType>
                                </xsd:element>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
            </xsd:complexType>
        </xsd:schema>
    </types>
</definitions>